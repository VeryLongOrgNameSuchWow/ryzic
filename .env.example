# ryzic configuration — copy to .env and fill in DISCORD_BOT_TOKEN.
# .env is git-ignored.

# Required: bot token from https://discord.com/developers/applications.
DISCORD_BOT_TOKEN=

# Lavalink server. The compose file sets HOST=lavalink automatically;
# override only when running ryzic outside compose.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333

# Required: shared secret between ryzic and the lavalink container. Pick a
# strong random value (e.g. `openssl rand -base64 32`). Both services read
# the same env var, so changing it here updates both at once.
LAVALINK_PASSWORD=

# Cache directory. Inside compose this is /var/cache/ryzic; locally a relative
# path is fine. The Lavalink container must mount the same directory.
RYZIC_CACHE_DIR=./.cache

# LRU eviction kicks in once total cached audio exceeds this size in GiB.
RYZIC_CACHE_MAX_GB=5

# Python logging level: DEBUG, INFO, WARNING, ERROR.
RYZIC_LOG_LEVEL=INFO

# Comma-separated guild IDs for instant slash-command propagation during
# development. Leave unset to register globally (~1h propagation).
# RYZIC_GUILD_IDS=123456789012345678

# Seconds to wait after the queue empties before disconnecting from voice.
# Set to 0 to disable auto-leave entirely (24/7 ambient music deployments).
RYZIC_AUTOLEAVE_SECONDS=300

# Opt-in: path to a YouTube cookies.txt file (Netscape format) for fetching
# age-restricted, private, or YouTube-Premium-only content.
#
# WARNING: anyone who can run /play on your bot can now fetch any video your
# YouTube account can see, including private uploads. The cookies file
# effectively grants every /play-er a session as your account. Do not enable
# on a server you don't fully control. See the README's "Self-hoster
# considerations" section before uncommenting.
#
# Generate via a browser extension (e.g. "Get cookies.txt LOCALLY") and mount
# read-only into the container.
# RYZIC_YOUTUBE_COOKIES_PATH=/etc/ryzic/youtube-cookies.txt
