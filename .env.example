# ryzic configuration — copy to .env and fill in DISCORD_BOT_TOKEN.
# .env is git-ignored.

# Required: bot token from https://discord.com/developers/applications.
DISCORD_BOT_TOKEN=

# Lavalink server. The compose file sets HOST=lavalink automatically;
# override only when running ryzic outside compose.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Cache directory. Inside compose this is /var/cache/ryzic; locally a relative
# path is fine. The Lavalink container must mount the same directory.
RYZIC_CACHE_DIR=./.cache

# LRU eviction kicks in once total cached audio exceeds this size in GiB.
RYZIC_CACHE_MAX_GB=5

# Python logging level: DEBUG, INFO, WARNING, ERROR.
RYZIC_LOG_LEVEL=INFO

# Comma-separated guild IDs for instant slash-command propagation during
# development. Leave unset to register globally (~1h propagation).
# RYZIC_GUILD_IDS=123456789012345678
